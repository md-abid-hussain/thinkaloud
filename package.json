{
  "name": "thinkaloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "check-maps": "uv run --with pyyaml python scripts/check_maps.py",
    "generate": "tsx --env-file=.env.local scripts/generate.ts",
    "review": "tsx scripts/review.ts",
    "sandbox:image": "docker build -t thinkaloud-sandbox sandbox",
    "sandbox:snapshot": "tsx --env-file=.env.local scripts/sandbox-snapshot.ts",
    "try-review": "tsx --env-file=.env.local scripts/try-review.ts",
    "validate-checks": "tsx --env-file=.env.local scripts/validate-checks.ts",
    "build-layers": "tsx --env-file=.env.local scripts/build-layers.ts"
  },
  "dependencies": {
    "@daytona/sdk": "^0.227.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
