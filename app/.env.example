# Copy to .env.local. Start the local database first with `docker compose up -d` from the repo root.
DATABASE_URL=postgres://thinkaloud:thinkaloud@localhost:5433/thinkaloud
ANTHROPIC_API_KEY=
LINKUP_API_KEY=
# Spend caps in US dollars. The mentor pauses, rather than fails, when one is reached.
DAILY_CAP_USD=20
GUEST_DAILY_CAP_USD=1.5
# Where the project maps live. Defaults to ../content when the app runs from app/.
# CONTENT_DIR=
# The chat model and its effort. Defaults: claude-haiku-5-5 at low effort.
# MENTOR_MODEL=claude-haiku-5-5
# MENTOR_EFFORT=low
# Daytona runs the sandbox reviews. Both are passed to the SDK explicitly (lib/sandbox/daytona.ts).
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# SANDBOX=docker runs reviews in the local image instead (npm run sandbox:image).
# SANDBOX=
