# Copy to .env.local for local development. Leave DATABASE_URL unset to use PGlite in .data/pglite.
# DATABASE_URL=postgresql://user:pass@host:5432/db
ANTHROPIC_API_KEY=
# Spend limits in US dollars. Grading and the mentor pause, rather than fail, when a cap is reached.
DAILY_CAP_USD=20
GUEST_DAILY_CAP_USD=1.5
